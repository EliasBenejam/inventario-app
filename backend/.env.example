# =========================================================
# Credenciales de Supabase - PLANTILLA
#
# 1) Copiar este archivo como "backend/.env" (mismo lugar, sin ".example").
# 2) Completar con los datos de Supabase:
#    boton "Connect" > pestaña JDBC > "Session pooler" (puerto 5432).
# 3) El archivo .env NO se sube al repositorio ni se entrega:
#    contiene la contrasena de la base de datos.
#
# Formato: CLAVE=valor, sin comillas ni espacios alrededor del "=".
# =========================================================
SUPABASE_DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.ID_DEL_PROYECTO
SUPABASE_DB_PASSWORD=CONTRASENA_DE_LA_BASE
